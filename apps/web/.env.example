# Supabase — get these from: supabase start (local) or Project Settings (cloud)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Demo tenant (seeded in supabase/seed.sql)
VITE_DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001

# AI keys NEVER go in VITE_* variables (they are bundled into the public JavaScript).
# AI runs through edge functions: set OPENAI_API_KEY (and/or GEMINI_API_KEY, ANTHROPIC_API_KEY)
# in Supabase Dashboard → Edge Functions → Secrets, plus MARBEE_SECRETS_KEY for sealing
# workspace keys saved in Settings → AI Engine.
# Then deploy: supabase functions deploy form-ai

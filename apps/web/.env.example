# apps/web — copy to .env.local (git-ignored). Or run `npm run dev:env`, which fills .env.local
# from your main checkout with these two values only.
#
# Every VITE_* value is bundled into the public JavaScript. Only browser-safe values go here.
# NEVER put API keys, service-role keys, passwords or tokens in a VITE_* variable.

# Required — Supabase → Project Settings → API (dev project ref: uqffhyaftlwetqigfenp)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — model name shown/used by the Form AI helper (not a secret). Default: gpt-4o-mini
# VITE_OPENAI_FORM_MODEL=gpt-4o-mini

# AI keys live server-side only: Supabase → Edge Functions → Secrets
# (OPENAI_API_KEY / GEMINI_API_KEY / ANTHROPIC_API_KEY …, plus MARBEE_SECRETS_KEY).
# See docs/cpo/runbooks/environments.md for every function secret.

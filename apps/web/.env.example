# Supabase — get these from: supabase start (local) or Project Settings (cloud)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Demo tenant (seeded in supabase/seed.sql)
VITE_DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001

# AI form generation (optional — local dev without Edge Functions)
# Get a key from https://platform.openai.com/api-keys
# Vite dev server proxies requests so the key stays server-side.
VITE_OPENAI_API_KEY=sk-your-openai-key
# VITE_OPENAI_FORM_MODEL=gpt-4o-mini

# Production: set OPENAI_API_KEY in Supabase Dashboard → Edge Functions → Secrets
# Then deploy: supabase functions deploy form-ai

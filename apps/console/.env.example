# apps/console — copy to .env.local (git-ignored). Or run `npm run dev:env`.
# Same Supabase project as the main app. The anon key is public by design;
# all console data goes through the `platform-admin` edge function.
# Never put secrets in a VITE_* variable — they are bundled into the public JavaScript.

# Required (not needed for `npm run dev:console:mock`)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Dev-only sample-data mode. Set by .env.mock when you run `npm run dev:mock` (port 5175);
# don't set it here.
# VITE_CONSOLE_MOCK=1
